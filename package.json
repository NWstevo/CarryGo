{
  "name": "carrygo",
  "version": "0.1.0",
  "private": true,
  "description": "CarryGo monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @carrygo/api",
    "dev:web": "npm run dev -w @carrygo/web",
    "start": "npm run start -w @carrygo/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
